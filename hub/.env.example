APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alert email goes through Mailgun in production:
# MAIL_MAILER=mailgun
# MAIL_FROM_ADDRESS="logwatch@mg.example.com"
MAILGUN_DOMAIN=
MAILGUN_SECRET=
# Use api.eu.mailgun.net for an EU Mailgun domain.
MAILGUN_ENDPOINT=api.mailgun.net

# Where alerts go. With no address, or LOGWATCH_SILENT=true, alerts are only
# shown on the dashboard (the tuning week runs silent).
LOGWATCH_ALERT_TO=
LOGWATCH_SILENT=false

# The nightly review.
ANTHROPIC_API_KEY=
LOGWATCH_REVIEW_MODEL=claude-sonnet-5-5
LOGWATCH_REVIEW_EFFORT=high

# SSH keys allowed to log in from outside the tailnet on every server: SHA256
# fingerprints (preferred) or authorized_keys comments, comma-separated.
LOGWATCH_SSH_ALLOWLIST=worker@forge.laravel.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
